# ==========================================
# LSTM 股票预测 - 环境变量示例
# ==========================================
# 复制此文件为 .env 并填入你的实际配置：
#   cp .env.example .env
# ⚠️ .env 已加入 .gitignore，不会被提交

# ---------- 数据源 ----------
# 默认股票代码（yfinance 格式）
TICKER=AAPL
# 数据起止日期
START_DATE=2015-01-01
END_DATE=2024-12-31

# ---------- 模型超参 ----------
# 输入序列长度（lookback window）
SEQUENCE_LENGTH=60
# LSTM 隐藏层大小
HIDDEN_SIZE=128
# LSTM 层数
NUM_LAYERS=2
# Dropout 比率
DROPOUT=0.2

# ---------- 训练超参 ----------
# 训练轮数
EPOCHS=50
# 批大小
BATCH_SIZE=32
# 学习率
LEARNING_RATE=0.001
# 早停 patience
EARLY_STOPPING_PATIENCE=5

# ---------- 回测 ----------
# 初始资金
INITIAL_CAPITAL=100000
# 交易成本（按比例）
TRANSACTION_COST=0.001
